# Fast local lint gate: the same formatting and Clippy checks enforced by CI.
# Full tests intentionally remain in s/test-fmt-clippy and CI.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets -- -D warnings
